#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "TechTadka360-Meter";
const char* password = "techtadka360";
WebServer server(80);

// Pin Definitions
const int PIN_REF = 25;    // 10k reference resistor
const int PIN_BUZZ = 26;   // Buzzer (+)
const int PIN_ADC_R = 33;  // 82k series resistor (Resistance / Continuity ADC)
const int PIN_ADC_V = 34;  // 150k + 82k voltage divider midpoint (Voltage ADC)

// Calibration Constants
const float V_REF = 3.30;
const float V_DIV_RATIO = 2.829; // (150k + 82k) / 82k
const float R_EQUIV = 9586.8;    // 10k || 232k parallel equivalent resistance

String currentMode = "OFF";
bool isBeeping = false;
float lastStableRx = -1.0;

// Oversampled ADC voltage reader to eliminate fluctuations
float readVoltage(int pin) {
  long sum = 0;
  for (int i = 0; i < 150; i++) {
    sum += analogReadMilliVolts(pin);
    delayMicroseconds(100);
  }
  return (sum / 150.0) / 1000.0;
}

// Hardware PWM buzzer controller (compatible with ESP32 Core v3.x)
void setBuzzer(bool state) {
  if (state && !isBeeping) {
    ledcAttach(PIN_BUZZ, 2500, 8);
    ledcWriteTone(PIN_BUZZ, 2500);
    isBeeping = true;
  } else if (!state && isBeeping) {
    ledcWriteTone(PIN_BUZZ, 0);
    ledcDetach(PIN_BUZZ);
    pinMode(PIN_BUZZ, OUTPUT);
    digitalWrite(PIN_BUZZ, LOW);
    isBeeping = false;
  }
}

