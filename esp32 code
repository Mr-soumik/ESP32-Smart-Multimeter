void handleMode() {
  if (server.hasArg("m")) {
    currentMode = server.arg("m");
    lastStableRx = -1.0;
    setBuzzer(false);
    if (currentMode == "OHM" || currentMode == "CONT") {
      pinMode(PIN_REF, OUTPUT);
      digitalWrite(PIN_REF, HIGH);
    } else {
      pinMode(PIN_REF, INPUT_PULLDOWN);
    }
  }
  server.send(200, "text/plain", "OK");
}

void handleData() {
  String l = "", v = "0.00", u = "";
  if (currentMode == "VOLT") {
    l = "DC"; u = "V";
    float vr = readVoltage(PIN_ADC_V) * V_DIV_RATIO;
    v = (vr < 0.48) ? "0.00" : String(vr, 2);
  } else if (currentMode == "OHM" || currentMode == "CONT") {
    float vp = readVoltage(PIN_ADC_R);
    if (currentMode == "CONT") {
      l = "•)))";
      if (vp <= 0.28) {
        v = "000"; u = "Ω";
      } else {
        v = "OL"; u = "";
      }
    } else {
      l = "Ω";
      if (vp >= 3.10) {
        v = "OL"; u = ""; lastStableRx = -1.0;
      } else {
        float vp_corr = (vp > 0.14) ? (vp - 0.14) : 0.0;
        float rx = (R_EQUIV * vp_corr) / (V_REF - vp);
        if (rx < 2.0) rx = 0.0;
        if (lastStableRx < 0 || abs(rx - lastStableRx) > (lastStableRx * 0.03 + 3.0)) lastStableRx = rx;
        else rx = lastStableRx;

        if (rx < 1000.0) { v = String((int)round(rx)); u = "Ω"; }
        else if (rx < 200000.0) { v = String(rx / 1000.0, 1); u = "kΩ"; }
        else { v = "OL"; u = ""; }
      }
    }
  }
  server.send(200, "application/json", "{\"l\":\"" + l + "\",\"v\":\"" + v + "\",\"u\":\"" + u + "\"}");
}

void setup() {
  pinMode(PIN_REF, INPUT_PULLDOWN);
  pinMode(PIN_BUZZ, OUTPUT);
  digitalWrite(PIN_BUZZ, LOW);
  analogReadResolution(12);

  // Startup buzzer test beep
  setBuzzer(true);
  delay(200);
  setBuzzer(false);

  WiFi.softAP(ssid, password);
  server.on("/", handleRoot);
  server.on("/mode", handleMode);
  server.on("/data", handleData);
  server.begin();
}

void loop() {
  server.handleClient();
  if (currentMode == "CONT") {
    float vp = analogReadMilliVolts(PIN_ADC_R) / 1000.0;
    setBuzzer(vp <= 0.28);
  } else if (isBeeping) {
    setBuzzer(false);
  }
}
